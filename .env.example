# RemoteMM Enterprise - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO GIT!

# Gateway & Node Server Environment
PORT=3001
NODE_ENV=production
GATEWAY_PORT=3001

# Public Web Ports
HTTP_PORT=80
HTTPS_PORT=443

# Cryptographic Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_here

# Domain & SSL (for VPS HTTPS/WSS deployment)
DOMAIN_NAME=remotemm.yourdomain.com
SSL_CERT_PATH=./nginx/certs/fullchain.pem
SSL_KEY_PATH=./nginx/certs/privkey.pem

# Agent TCP Defaults
DEFAULT_AGENT_PORT=6129
